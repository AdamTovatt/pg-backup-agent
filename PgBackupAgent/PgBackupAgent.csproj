<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-PgBackupAgent-d112e56a-ba1b-49cf-aef1-e5ef6e712828</UserSecretsId>
    <Version>2.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ByteShelfClient" Version="2.0.0" />
    <PackageReference Include="ByteShelfCommon" Version="2.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="PgDump" Version="1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- At the release root, where updaemon reads it (see README.md, Installing with updaemon). -->
    <Content Update="updaemon.json" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
  </ItemGroup>
</Project>
