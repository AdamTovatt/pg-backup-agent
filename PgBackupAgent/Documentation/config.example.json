{
  "postgres": {
    "host": "localhost",
    "port": 5432,
    "username": "postgres",
    "password": "your_password_here",
    "database": "postgres"
  },
  "byteShelf": {
    "url": "https://files.example.com",
    "shelf": "postgres-backups",
    "shelfKey": "bsk_your_read_write_shelf_key"
  },
  "backup": {
    "source": "db-server-1",
    "retentionPolicyPath": "/etc/pg-backup-agent/retention-policy.json",
    "timeoutMinutes": 60
  }
}
